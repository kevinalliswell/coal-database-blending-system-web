# Flask 基础配置
FLASK_APP=run.py
FLASK_CONFIG=development
HOST=0.0.0.0
PORT=5000
SECRET_KEY=please-change-this-secret-key

# 数据模式: csv 或 database
DATA_STORAGE_MODE=csv

# 可选：指定数据库连接字符串
# SQLite 示例
# DATABASE_URL=sqlite:///data/coal_system.db
#
# MySQL 示例
# DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/coal_blending
