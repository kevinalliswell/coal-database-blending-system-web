# version control / CI
.git
.github
.gitignore

# python runtime artifacts
**/__pycache__
*.pyc
.venv
venv
.pytest_cache
.mypy_cache

# local data / runtime products (image seeds from data/*.csv, not the db)
data/coal_system.db
data/uploads
data/history
*.sqlite
*.db

# frontend build inputs we don't want in context (rebuilt in-image)
frontend/node_modules
frontend/dist
frontend/.vite

# editor / os
.DS_Store
.idea
.vscode

# docs that don't affect the image
tests
docs
*.md
